# Start with: frankenphp run

{
    admin off
    frankenphp {
        worker {
            file public/frankenphp-worker.php
        }
    }
}

localhost {
    root * public
    encode zstd br gzip
    redir /swagger /swagger/ 308
    handle_path /swagger/* {
        reverse_proxy swagger-ui:8080
    }
    handle {
        php_server {
            try_files {path} frankenphp-worker.php
        }
        file_server
    }
}
